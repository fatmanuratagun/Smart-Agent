@model List<SmartAgent.Services.SearchRecord>

@{
    ViewData["Title"] = "Arama Geçmişim";
}

<div style="max-width:800px; margin: 40px auto; padding: 0 20px;">

    <div style="margin-bottom: 32px;">
        <h1 style="font-size: 28px; font-weight: 600; color: #1a1a2e;">
            🕓 Arama Geçmişim
        </h1>
        <p style="color: #666; margin-top: 6px;">
            Aura'ya daha önce sorduğun tüm sorgular
        </p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div style="text-align:center; padding: 60px 20px; background: #f8f9ff;
                    border-radius: 16px; color: #888;">
            <div style="font-size: 48px; margin-bottom: 16px;">🔍</div>
            <p style="font-size: 18px;">Henüz arama yapmadın.</p>
            <a href="/" style="display:inline-block; margin-top: 16px; padding: 12px 28px;
                               background: #6c63ff; color: white; border-radius: 10px;
                               text-decoration: none; font-weight: 500;">
                İlk aramanı yap
            </a>
        </div>
    }
    else
    {
        <div style="display: flex; flex-direction: column; gap: 12px;">
            @foreach (var item in Model)
            {
                <div style="background: white; border: 1px solid #eee; border-radius: 14px;
            padding: 18px 22px; display: flex; align-items: center;
            justify-content: space-between; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">

                    <!-- Sol: ikon + metin -->
                    <div style="display: flex; align-items: center; gap: 14px; flex: 1;">
                        <div style="width: 42px; height: 42px; background: #f0eeff;
                    border-radius: 10px; display: flex; align-items: center;
                    justify-content: center; font-size: 20px;">
                            🔍
                        </div>
                        <div>
                            <div style="font-weight: 600; font-size: 16px; color: #1a1a2e;">
                                @item.Query
                            </div>
                            <div style="font-size: 13px; color: #999; margin-top: 3px;">
                                @DateTime.Parse(item.Timestamp).ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                            </div>
                        </div>
                    </div>

                    <!-- Sağ: butonlar -->
                    <div style="display: flex; gap: 8px; align-items: center; flex-shrink: 0;">
                        <a href="/?userQuery=@Uri.EscapeDataString(item.Query)"
                           style="padding: 8px 18px; background: #6c63ff; color: white;
                  border-radius: 8px; text-decoration: none; font-size: 13px;
                  font-weight: 500; white-space: nowrap;">
                            Tekrar ara
                        </a>

                        <form method="post" action="/Home/DeleteSearch"
                              onsubmit="return confirm('Bu aramayı silmek istediğine emin misin?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="searchId" value="@item.FirebaseKey" />
                            <button type="submit"
                                    style="padding: 8px 18px; background: #fff; color: #e53e3e;
                           border: 1px solid #e53e3e; border-radius: 8px;
                           font-size: 13px; font-weight: 500; cursor: pointer;
                           white-space: nowrap;">
                                Sil
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }

    <div style="margin-top: 32px;">
        <a href="/" style="color: #6c63ff; text-decoration: none; font-size: 14px;">
            ← Ana sayfaya dön
        </a>
    </div>
</div>