@model List<SmartAgent.Controllers.HistoryItem>
@{
    ViewData["Title"] = "Arama Geçmişim";
    var advices = ViewBag.FormattedAdvices as Dictionary<string, string>;
}

<style>
    .history-page {
        max-width: 760px;
        margin: 40px auto;
        padding: 0 24px 60px;
    }

    .history-title {
        font-family: var(--font-display);
        font-size: 26px;
        font-weight: 800;
        color: var(--text);
        margin-bottom: 6px;
    }

    .history-sub {
        color: var(--muted);
        font-size: 14px;
        margin-bottom: 28px;
    }

    .history-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 16px 20px;
        margin-bottom: 10px;
        transition: border-color 0.2s;
    }

        .history-card:hover {
            border-color: var(--accent2);
        }

    .history-icon {
        width: 40px;
        height: 40px;
        background: rgba(124,111,255,0.15);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        margin-right: 14px;
        flex-shrink: 0;
    }

    .history-query {
        font-weight: 600;
        font-size: 14px;
        color: var(--text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 450px;
        cursor: pointer;
        transition: color 0.2s;
    }

        .history-query:hover {
            color: var(--accent);
        }

        .history-query.expanded {
            white-space: normal;
            overflow: visible;
            text-overflow: unset;
        }

    .history-date {
        font-size: 12px;
        color: var(--muted);
        margin-top: 3px;
    }

    .btn-again {
        padding: 7px 16px;
        background: var(--accent2);
        color: white;
        border-radius: 8px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 500;
        white-space: nowrap;
        transition: opacity 0.2s;
    }

        .btn-again:hover {
            opacity: 0.85;
            color: white;
        }

    .btn-show {
        padding: 7px 16px;
        background: transparent;
        color: var(--accent);
        border: 1px solid var(--accent);
        border-radius: 8px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        white-space: nowrap;
        font-family: var(--font-body);
        transition: all 0.2s;
    }

        .btn-show:hover {
            background: rgba(200,241,53,0.1);
        }

    .btn-delete {
        padding: 7px 16px;
        background: transparent;
        color: #e53e3e;
        border: 1px solid #e53e3e;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        white-space: nowrap;
        font-family: var(--font-body);
        transition: all 0.2s;
    }

        .btn-delete:hover {
            background: rgba(229,62,62,0.1);
        }

    .advice-panel {
        display: none;
        margin-top: 16px;
        padding-top: 16px;
        border-top: 1px solid var(--border);
        font-size: 13px;
        color: #ccc;
        line-height: 1.7;
    }

        .advice-panel a {
            color: var(--accent);
            text-decoration: none;
        }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 16px;
        color: var(--muted);
    }
</style>

<div class="history-page">
    <div class="history-title">🕓 Arama Geçmişim</div>
    <div class="history-sub">Aura'ya daha önce sorduğun tüm sorgular</div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            <div style="font-size:40px; margin-bottom:12px;">🔍</div>
            <p>Henüz arama yapmadın.</p>
            <a href="/" style="display:inline-block; margin-top:14px; padding:10px 24px;
                               background:var(--accent); color:#0f0f13; border-radius:9px;
                               text-decoration:none; font-weight:700; font-family:var(--font-display);">
                İlk aramanı yap
            </a>
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div class="history-card">

                <!-- Üst satır -->
                <div style="display:flex; align-items:center; justify-content:space-between;">
                    <div style="display:flex; align-items:center; flex:1; min-width:0;">
                        <div class="history-icon">🔍</div>
                        <div style="min-width:0;">
                            <div class="history-query" onclick="toggleQuery(this)">@item.Query</div>
                            <div class="history-date">
                                @DateTime.Parse(item.Timestamp).ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                            </div>                                                      
                        </div>
                    </div>
                    <div style="display:flex; gap:8px; flex-shrink:0; margin-left:16px;">                     
                        <a href="/?userQuery=@Uri.EscapeDataString(item.Query)" class="btn-again">
                            Tekrar ara
                        </a>
                        <form method="post" action="/Home/DeleteSearch"
                              onsubmit="return confirm('Silinsin mi?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="searchId" value="@item.FirebaseKey" />
                            <button type="submit" class="btn-delete">Sil</button>
                        </form>
                    </div>
                </div>              
            </div>
        }
    }

</div>
<script>
    function toggleQuery(el) {
        el.classList.toggle('expanded');
    }
</script>
