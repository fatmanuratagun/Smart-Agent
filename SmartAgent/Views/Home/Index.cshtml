@{
    ViewData["Title"] = "Aura";
}

<style>
    .chat-page {
        height: 100vh;
        display: flex;
        flex-direction: column;
        background: var(--bg);
    }

    .chat-header {
        padding: 20px 32px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--sidebar);
    }

    .chat-header-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .status-dot {
        width: 9px;
        height: 9px;
        background: var(--accent);
        border-radius: 50%;
        box-shadow: 0 0 8px var(--accent);
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.4;
        }
    }

    .chat-header h1 {
        font-family: var(--font-display);
        font-size: 17px;
        font-weight: 700;
        color: var(--text);
        margin: 0;
    }

    .chat-header p {
        font-size: 12px;
        color: var(--muted);
        margin: 0;
    }

    .btn-clear {
        background: transparent;
        border: 1px solid var(--border);
        color: var(--muted);
        padding: 7px 16px;
        border-radius: 8px;
        font-size: 13px;
        cursor: pointer;
        transition: all 0.2s;
        font-family: var(--font-body);
    }

        .btn-clear:hover {
            border-color: #e53e3e;
            color: #e53e3e;
        }

    .chat-body {
        flex: 1;
        overflow-y: auto;
        padding: 32px;
        display: flex;
        flex-direction: column;
        gap: 20px;
        scroll-behavior: smooth;
    }

        .chat-body::-webkit-scrollbar {
            width: 4px;
        }

        .chat-body::-webkit-scrollbar-track {
            background: transparent;
        }

        .chat-body::-webkit-scrollbar-thumb {
            background: var(--border);
            border-radius: 4px;
        }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .bubble-user {
        align-self: flex-end;
        background: linear-gradient(135deg, #3d3580, #2d2b55);
        border: 1px solid #5a54a0;
        color: #e0deff;
        padding: 12px 20px;
        border-radius: 18px 18px 4px 18px;
        max-width: 60%;
        font-size: 14px;
        line-height: 1.6;
        animation: fadeUp 0.3s ease;
        font-weight: 400;
        box-shadow: 0 4px 16px rgba(61, 53, 128, 0.4);
    }

    /* Aura balonu — daha parlak metin */
    .bubble-aura {
        align-self: flex-start;
        background: #1a1a24;
        border: 1px solid rgba(200, 241, 53, 0.15);
        padding: 24px 28px;
        border-radius: 4px 18px 18px 18px;
        max-width: 85%;
        font-size: 14px;
        line-height: 1.8;
        color: #e8e8f0;
        animation: fadeUp 0.4s ease;
    }


    /* Başlık stilleri daha belirgin */
    .bubble-aura-label {
        font-size: 10px;
        font-weight: 700;
        color: var(--accent);
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 14px;
        font-family: var(--font-display);
        opacity: 0.8;
    }

    /* Emoji başlıklar */
    .bubble-aura div[style*="font-size:17px"] {
        color: #f0f0f0 !important;
        font-size: 15px !important;
        margin: 18px 0 8px !important;
    }

    /* Karşılama balonu */
    .welcome-bubble {
        align-self: flex-start;
        background: #1a1a24;
        border: 1px solid rgba(200, 241, 53, 0.2);
        padding: 22px 26px;
        border-radius: 4px 18px 18px 18px;
        max-width: 480px;
        animation: fadeUp 0.5s ease;
    }


        .welcome-bubble p {
            font-size: 14px;
            color: #9090a8;
            margin: 0;
            line-height: 1.7;
        }

        .welcome-bubble strong {
            color: var(--accent);
            font-family: var(--font-display);
            font-size: 17px;
            display: block;
            margin-bottom: 8px;
        }

    .loading-bubble {
        align-self: flex-start;
        background: var(--card);
        border: 1px solid var(--border);
        padding: 18px 22px;
        border-radius: 4px 18px 18px 18px;
        display: flex;
        align-items: center;
        gap: 14px;
        animation: fadeUp 0.3s ease;
    }

    .dots {
        display: flex;
        gap: 5px;
    }

        .dots span {
            width: 7px;
            height: 7px;
            background: var(--accent);
            border-radius: 50%;
            animation: bounce 1.2s infinite;
        }

            .dots span:nth-child(2) {
                animation-delay: 0.2s;
            }

            .dots span:nth-child(3) {
                animation-delay: 0.4s;
            }

    @@keyframes bounce {
        0%, 100% {
            transform: translateY(0);
            opacity: 0.4;
        }

        50% {
            transform: translateY(-5px);
            opacity: 1;
        }
    }

    .loading-text {
        font-size: 13px;
        color: var(--muted);
        transition: opacity 0.3s;
    }

    .chat-input-area {
        padding: 20px 32px;
        border-top: 1px solid var(--border);
        background: var(--sidebar);
    }

    .input-row {
        display: flex;
        gap: 12px;
        align-items: center;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 6px 6px 6px 18px;
        transition: border-color 0.2s;
    }

        .input-row:focus-within {
            border-color: var(--accent2);
        }

        .input-row input {
            flex: 1;
            background: transparent;
            border: none;
            outline: none;
            color: var(--text);
            font-size: 14px;
            font-family: var(--font-body);
            padding: 8px 0;
        }

            .input-row input::placeholder {
                color: var(--muted);
            }

    .btn-send {
        background: var(--accent);
        border: none;
        color: #0f0f13;
        font-weight: 700;
        font-family: var(--font-display);
        font-size: 13px;
        padding: 10px 22px;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s;
        white-space: nowrap;
    }

        .btn-send:hover {
            background: #d4f550;
            transform: scale(1.03);
        }

        .btn-send:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }

    .bubble-aura table {
        width: 100%;
        border-collapse: collapse;
        margin: 14px 0;
        font-size: 13px;
    }

    .bubble-aura th {
        background: rgba(200, 241, 53, 0.12);
        color: #0f0f13;
        background: var(--accent);
        padding: 10px 14px;
        text-align: left;
        font-weight: 700;
        border-bottom: none;
        font-size: 13px;
    }

    /* Tablo satır rengi */
    .bubble-aura td {
        padding: 9px 14px;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        color: #d0d0e0;
        font-size: 13px;
    }

    .bubble-aura tr:last-child td {
        border-bottom: none;
    }

    .bubble-aura tr:hover td {
        background: rgba(255,255,255,0.03);
    }

    .bubble-aura a {
        color: var(--accent) !important;
        text-decoration: none;
    }

        .bubble-aura a:hover {
            text-decoration: underline;
        }

    .bubble-aura strong {
        color: var(--text);
    }

    .bubble-aura h3 {
        color: #f0f0f0;
        font-size: 15px;
        font-weight: 700;
        margin: 18px 0 8px;
        font-family: var(--font-display);
    }

    .bubble-aura p {
        color: #c8c8d8;
        line-height: 1.8;
        margin-bottom: 8px;
    }

    .bubble-aura b {
        color: #f0f0f0;
    }

    .bubble-aura a {
        color: var(--accent) !important;
        text-decoration: none;
        font-weight: 600;
    }

        .bubble-aura a:hover {
            text-decoration: underline;
        }
</style>

<div class="chat-page">
    <div class="chat-header">
        <div class="chat-header-left">
            <div class="status-dot"></div>
            <div>
                <h1>Aura</h1>
                <p>Akıllı Alışveriş Danışmanı</p>
            </div>
        </div>
        <button class="btn-clear" onclick="clearChat()">Sohbeti Temizle</button>
    </div>

    <div class="chat-body" id="chat-body">
        <div class="welcome-bubble" id="welcome">
            <strong>Merhaba! Ben Akıllı Alışveriş Asistanın Aura 🧠✨</strong>
            <p>Bana bütçeni, aradığın ürünleri veya karşılaştırmak istediğin linkleri söyle; senin için interneti tarayıp en dürüst analizi ve en doğru fiyat linklerini çıkarayım.</p>
            <div style="margin-top: 10px; padding-top: 8px; border-top: 1px solid rgba(255,255,255,0.1); font-size: 13px; opacity: 0.8;">
                ⏱️ <b>Akıllı Hafıza Aktif:</b> Üye olmana gerek yok! Yaptığın tüm keşifler 30 gün boyunca <b>Aura Arşivi</b>'nde saklanır, dilediğin an tek tıkla temizleyebilirsin.
            </div>
        </div>
    </div>

    <div class="chat-input-area">
        <div class="input-row">
            <input type="text" id="userQuery"
                   placeholder="Örn: 25.000 TL bütçem var, bataryası iyi telefon öner">
            <button class="btn-send" id="btn-send" onclick="sendMessage()">Gönder →</button>
        </div>
    </div>
</div>

<script>
    const loadingMessages = [
        "Teknoloji forumları taranıyor...",
        "Kullanıcı şikayetleri okunuyor...",
        "Fiyat geçmişi analiz ediliyor...",
        "Satıcı güven skorları hesaplanıyor...",
        "Aura tavsiyesi hazırlanıyor..."
    ];

    let msgIndex = 0;
    let loadingInterval = null;

    function scrollBottom() {
        const body = document.getElementById('chat-body');
        body.scrollTop = body.scrollHeight;
    }

    function addUserBubble(text) {
        const div = document.createElement('div');
        div.className = 'bubble-user';
        div.textContent = text;
        document.getElementById('chat-body').appendChild(div);
        scrollBottom();
    }

    function addLoadingBubble() {
        const div = document.createElement('div');
        div.className = 'loading-bubble';
        div.id = 'loading-bubble';
        div.innerHTML = `
            <div class="dots">
                <span></span><span></span><span></span>
            </div>
            <div class="loading-text" id="loading-text">${loadingMessages[0]}</div>
        `;
        document.getElementById('chat-body').appendChild(div);
        scrollBottom();

        msgIndex = 0;
        loadingInterval = setInterval(() => {
            msgIndex = (msgIndex + 1) % loadingMessages.length;
            const el = document.getElementById('loading-text');
            if (el) {
                el.style.opacity = '0';
                setTimeout(() => {
                    el.textContent = loadingMessages[msgIndex];
                    el.style.opacity = '1';
                }, 300);
            }
        }, 2000);
    }

    function removeLoadingBubble() {
        clearInterval(loadingInterval);
        const el = document.getElementById('loading-bubble');
        if (el) el.remove();
    }

    function addAuraBubble(html) {
        const div = document.createElement('div');
        div.className = 'bubble-aura';
        div.innerHTML = `<div class="bubble-aura-label">Aura</div>` + html;
        document.getElementById('chat-body').appendChild(div);
        scrollBottom();
    }

    async function sendMessage() {
        const input = document.getElementById('userQuery');
        const query = input.value.trim();
        if (!query) return;

        // Karşılama balonunu gizle
        const welcome = document.getElementById('welcome');
        if (welcome) welcome.style.display = 'none';

        input.value = '';
        input.disabled = true;
        document.getElementById('btn-send').disabled = true;

        addUserBubble(query);
        addLoadingBubble();

        try {
            const formData = new FormData();
            formData.append('userQuery', query);

            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) formData.append('__RequestVerificationToken', token.value);

            const response = await fetch('/Home/AjaxQuery', {
                method: 'POST',
                body: formData
            });

            const data = await response.json();
            removeLoadingBubble();
            addAuraBubble(data.html);

        } catch (err) {
            removeLoadingBubble();
            addAuraBubble('<p style="color:#e53e3e;">Bir hata oluştu, tekrar dene.</p>');
        }

        input.disabled = false;
        document.getElementById('btn-send').disabled = false;
        input.focus();
    }

    function clearChat() {
        const body = document.getElementById('chat-body');
        body.innerHTML = `
                <div class="welcome-bubble" id="welcome">
        <strong>Merhaba! Ben Akıllı Alışveriş Asistanın Aura 🧠✨</strong>
        <p>Bana bütçeni, aradığın ürünleri veya karşılaştırmak istediğin linkleri söyle; senin için interneti tarayıp en dürüst analizi ve en doğru fiyat linklerini çıkarayım.</p>
        <div style="margin-top: 10px; padding-top: 8px; border-top: 1px solid rgba(255,255,255,0.1); font-size: 13px; color: var(--muted);">
            ⏱️ <b>Akıllı Hafıza Aktif:</b> Üye olmana gerek yok! Yaptığın tüm keşifler 30 gün boyunca <b>Aura Arşivi</b>'nde saklanır, dilediğin an tek tıkla temizleyebilirsin.
        </div>
    </div>
        `;
    }

    // Enter ile gönder
    document.getElementById('userQuery').addEventListener('keydown', function(e) {
        if (e.key === 'Enter') sendMessage();
    });

    // URL'den otomatik arama (geçmişten "Tekrar ara")
    const urlParams = new URLSearchParams(window.location.search);
    const query = urlParams.get('userQuery');
    if (query) {
        document.getElementById('userQuery').value = query;
        sendMessage();
    }
</script>

@Html.AntiForgeryToken()